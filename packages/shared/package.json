{
  "name": "@festaflow/shared",
  "version": "0.1.0",
  "private": true,
  "description": "FestaFlow 프론트/백엔드 공유 계약. 백엔드 소유, 프론트는 읽기 전용.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./enums": "./src/enums.ts",
    "./constants": "./src/constants.ts",
    "./types": "./src/types.ts"
  },
  "files": [
    "src",
    "openapi.json"
  ],
  "scripts": {
    "generate": "openapi-typescript ./openapi.json -o ./src/generated.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
