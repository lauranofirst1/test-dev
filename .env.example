# ─────────────────────────────────────────────────────────────
# FestaFlow 환경변수 템플릿
#   cp .env.example .env  후 값을 채우세요.
#   .env 는 .gitignore 에 있습니다. 인증키를 커밋하지 마세요.
# ─────────────────────────────────────────────────────────────

# ── 데이터베이스 ────────────────────────────────────────────
# 로컬: postgresql+psycopg://festaflow:festaflow@localhost:5432/festaflow
# 배포: Neon / Supabase 등에서 발급받은 URL (sslmode=require 포함)
DATABASE_URL=postgresql+psycopg://festaflow:festaflow@localhost:5432/festaflow

# ── 한국관광공사 OpenAPI ────────────────────────────────────
# 공공데이터포털 마이페이지 > 오픈API > 개발계정에서 발급.
# ⚠ Encoding / Decoding 두 벌 중 "Decoding 키"를 넣으세요.
#   Encoding 키를 넣으면 HTTP 클라이언트가 재인코딩해 %2B → %252B 가 되어 인증이 깨집니다.
KTO_API_KEY=

# 계정을 분리해 운영할 때만 사용하는 선택적 오버라이드.
# 비워두면 KTO_API_KEY 를 씁니다.
KTO_DEMAND_API_KEY=
KTO_TOUR_API_KEY=

# 기관 코드 경로 — 26종 API 공통
KTO_BASE_URL=https://apis.data.go.kr/B551011

# 활용 통계 산출용. 모든 요청에 필수이며 영문이라 인코딩 불필요.
KTO_MOBILE_APP=FestaFlow

# 개발계정 일 한도. 초과 전 경고 로그를 남깁니다.
KTO_DAILY_QUOTA=1000

# 외부 API 타임아웃(초)과 재시도 횟수
KTO_TIMEOUT_SECONDS=8
KTO_MAX_RETRIES=2

# 진단 점수 표시 모드: auto | score | checklist
#   auto  — 채점표 백테스트 기록이 있을 때만 공개 (가장 정직한 기본값)
#   score — 항상 공개. 지정과제 9번이 '흥행도 도출'을 요구하므로 공모전 출품 시 사용.
#           단 화면에 '준비도 상대 지표이며 흥행을 보증하지 않는다'를 함께 표시할 것.
DIAGNOSIS_SCORE_MODE=score

# 🚨 공모전 기간에는 반드시 false.
#   공모전 규정이 "실시간 호출"을 요구하고 인증키의 실제 호출 이력을 검증합니다.
#   true 로 두면 캐시 히트 시 호출이 0회가 되어 심사 불이익을 받을 수 있습니다.
#   수상 이후 운영 단계에서 true 로 바꿔 일 1,000건 한도를 아끼세요.
TOURISM_SNAPSHOT_CACHE_ENABLED=false
TOURISM_SNAPSHOT_TTL_DAYS=7

# ── 인증 ────────────────────────────────────────────────────
# 운영에서는 반드시 교체하세요: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-0123456789abcdef
JWT_TTL_HOURS=12

# ── 애플리케이션 ────────────────────────────────────────────
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 데모 축제 자동 시드 (데모가 0건일 때만 동작)
DEMO_MODE=false

# ── 데이터 보존 ─────────────────────────────────────────────
ANONYMIZE_AFTER_DAYS=90
MEDIA_RETENTION_DAYS=90

# ── 도메인 임계값 (docs/02-data-model.md 와 일치) ───────────
SCAN_TOKEN_WINDOW_SECONDS=300
INSIGHTS_MIN_SAMPLE=10
