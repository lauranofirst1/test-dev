# ─────────────────────────────────────────────────────────────
# FestaFlow 환경변수 템플릿
#   cp .env.example .env  후 값을 채우세요.
#   .env 는 .gitignore 에 있습니다. 인증키를 커밋하지 마세요.
# ─────────────────────────────────────────────────────────────

# ── 데이터베이스 ────────────────────────────────────────────
# 로컬: 아래 값 그대로 (README 의 개발 환경 준비)
# 배포(docker compose): 이 값은 무시됩니다 — compose 가 db 컨테이너 주소로 덮습니다.
DATABASE_URL=postgresql+psycopg://festaflow:festaflow@localhost:5432/festaflow

# ── 배포 전용 (docker compose) ──────────────────────────────
# 로컬 개발에서는 아무것도 안 해도 됩니다. 서버에서만 채웁니다 — docs/11-deploy.md
#
# 접속할 주소. **도메인을 넣으면 Caddy 가 HTTPS 인증서를 자동으로 받습니다.**
# 부스 QR 스캔이 카메라를 쓰는데 브라우저는 HTTPS 가 아니면 카메라를 열어 주지
# 않습니다. 즉 IP 만으로 띄우면 스캔 기능이 통째로 죽습니다.
SITE_ADDRESS=
# DB 컨테이너 비밀번호. 아무 긴 문자열이면 됩니다 — 밖으로 열리지 않습니다.
#   openssl rand -base64 24
POSTGRES_PASSWORD=
# uvicorn 프로세스 수. 서버 코어 수에 맞춥니다.
API_WORKERS=4

# ── 한국관광공사 OpenAPI ────────────────────────────────────
# 공공데이터포털 마이페이지 > 오픈API > 개발계정에서 발급.
# ⚠ Encoding / Decoding 두 벌 중 "Decoding 키"를 넣으세요.
#   Encoding 키를 넣으면 HTTP 클라이언트가 재인코딩해 %2B → %252B 가 되어 인증이 깨집니다.
KTO_API_KEY=

# 계정을 분리해 운영할 때만 사용하는 선택적 오버라이드.
# 비워두면 KTO_API_KEY 를 씁니다.
KTO_DEMAND_API_KEY=
KTO_TOUR_API_KEY=

# 기관 코드 경로 — 26종 API 공통
KTO_BASE_URL=https://apis.data.go.kr/B551011

# 활용 통계 산출용. 모든 요청에 필수이며 영문이라 인코딩 불필요.
KTO_MOBILE_APP=FestaFlow

# 개발계정 일 한도. 초과 전 경고 로그를 남깁니다.
KTO_DAILY_QUOTA=1000

# 외부 API 타임아웃(초)과 재시도 횟수
KTO_TIMEOUT_SECONDS=8
KTO_MAX_RETRIES=2

# 진단 점수 표시 모드: auto | score | checklist
#   auto  — 채점표 백테스트 기록이 있을 때만 공개 (가장 정직한 기본값)
#   score — 항상 공개. 지정과제 9번이 '흥행도 도출'을 요구하므로 공모전 출품 시 사용.
#           단 화면에 '준비도 상대 지표이며 흥행을 보증하지 않는다'를 함께 표시할 것.
DIAGNOSIS_SCORE_MODE=score

# 🚨 공모전 기간에는 반드시 false.
#   공모전 규정이 "실시간 호출"을 요구하고 인증키의 실제 호출 이력을 검증합니다.
#   true 로 두면 캐시 히트 시 호출이 0회가 되어 심사 불이익을 받을 수 있습니다.
#   수상 이후 운영 단계에서 true 로 바꿔 일 1,000건 한도를 아끼세요.
TOURISM_SNAPSHOT_CACHE_ENABLED=false
TOURISM_SNAPSHOT_TTL_DAYS=7

# ── 인증 ────────────────────────────────────────────────────
# 운영에서는 반드시 교체하세요: openssl rand -hex 32
# APP_ENV 가 local 이 아닐 때 이 기본값이거나 32자 미만이면 **앱이 부팅을 거부합니다.**
# 시크릿이 저장소에 공개된 채로 배포되면 세션 토큰을 누구나 위조할 수 있습니다.
JWT_SECRET=dev-only-change-me-0123456789abcdef
JWT_TTL_HOURS=12
# 접근 코드 연속 실패 허용 횟수와 잠금 시간
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=10

# ── 애플리케이션 ────────────────────────────────────────────
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 데모 축제 자동 시드 (데모가 0건일 때만 동작)
DEMO_MODE=false

# ── 데이터 보존 ─────────────────────────────────────────────
ANONYMIZE_AFTER_DAYS=90
MEDIA_RETENTION_DAYS=90

# ── 도메인 임계값 (docs/02-data-model.md 와 일치) ───────────
SCAN_TOKEN_WINDOW_SECONDS=30
INSIGHTS_MIN_SAMPLE=10

# 관객이 실제로 접속하는 프런트엔드 주소. 부스 QR 에 담을 링크를 만들 때 씁니다.
#
# 비워 두면 요청이 도착한 주소(= API 서버)를 씁니다. 개발 환경에서는 프런트가
# 5173, API 가 8000 이라 QR 이 API 서버를 가리키고 거기엔 /join 라우트가 없습니다.
# 부스 QR 화면(브라우저)은 이 값 대신 자기 오리진을 쓰므로 개발 중에는 비워 둬도
# 됩니다. **배포에서는 반드시 채우세요.**
# PUBLIC_WEB_ORIGIN=https://festaflow.example.com

# 세션 쿠키. 토큰은 httpOnly 쿠키로만 오가며 화면(JS)이 읽을 수 없습니다 —
# localStorage 에 두면 XSS 한 번에 전부 털립니다.
#
# SESSION_COOKIE_SECURE 는 **배포에서 반드시 true** 로 두세요. 로컬은 http 라
# 켜면 브라우저가 쿠키를 저장조차 하지 않아 기본값이 false 입니다.
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=strict

# ── 메일 발송 (비밀번호 재설정) ───────────────────────────────────────────────
# 비워 두면 메일을 보내지 않습니다. 로컬에서는 링크가 서버 로그에 남고,
# 그 밖의 환경에서는 "보내지 못했다"는 오류 로그가 남습니다 —
# 조용히 성공한 척하면 사용자는 영원히 메일을 기다립니다.
#
# MAIL_FROM 은 도메인의 SPF·DKIM 에 등록된 주소여야 스팸함을 피합니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 587 포트는 STARTTLS(기본), 465 포트를 쓸 때만 SMTP_USE_SSL=true
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MAIL_FROM=
MAIL_FROM_NAME=FestaFlow

# 재설정 링크 유효 시간(분). 메일 본문이 이 값을 그대로 알립니다.
RESET_TTL_MINUTES=30
